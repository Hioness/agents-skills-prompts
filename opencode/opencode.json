{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "minimal",
  "instructions": [
    "~/.config/opencode/working-dir.md",
    "~/.agents/skills/ste-writing/ste-always-on.md"
  ],
  "permissions": [
    { "action": "external_directory", "resource": "~/.agents/**", "effect": "allow" }
  ],
  "agents": {
    "build": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    }
  }
}
